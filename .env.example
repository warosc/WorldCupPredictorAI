# Database
POSTGRES_DB=quiniesys
POSTGRES_USER=quiniesys
POSTGRES_PASSWORD=quiniesys_pass
DATABASE_URL=postgresql://quiniesys:quiniesys_pass@postgres:5432/quiniesys

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ML Engine
ML_ENGINE_URL=http://ml-engine:8001

# External APIs
API_FOOTBALL_KEY=
FOOTBALL_DATA_KEY=
ANTHROPIC_API_KEY=

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Monitoring
GRAFANA_PASSWORD=admin
